# MongoDB Atlas
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
DB_NAME=feira_ciencias

# Google Identity Services (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=

# Owner and shared mural password
MURAL_OWNER_EMAIL=
FEEDBACK_MURAL_PASSWORD=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional; same-origin Pages proxy is used in production
CORS_ORIGINS=https://feira-ciencias.pages.dev
